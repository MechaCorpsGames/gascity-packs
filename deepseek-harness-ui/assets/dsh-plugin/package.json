{
  "name": "@gastownhall/deepseek-harness-ui",
  "version": "0.1.0",
  "description": "Gas City workspace for the stock DeepSeek Harness web profile",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "vitest run",
    "test:e2e:install": "node tests/e2e/check-artifact.mjs",
    "test:e2e:contract": "playwright test --config playwright.config.mjs",
    "test:e2e:soak": "playwright test --config playwright.soak.config.mjs",
    "test:e2e:live": "node tests/e2e/live-certificate.mjs",
    "test:e2e:live:isolated": "node tests/e2e/isolated-live-certificate.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "package.json"
  ],
  "peerDependencies": {
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "pnpm": "11.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "smol-toml": "1.4.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "4.0.11"
  },
  "dependencies": {
    "smol-toml": "1.4.2",
    "undici": "8.10.0"
  },
  "license": "MIT"
}
